{
  "name": "Lume — leitor Markdown",
  "short_name": "Lume",
  "description": "Leitor Markdown local com links wiki.",
  "id": "/",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f4f1ea",
  "theme_color": "#f4f1ea",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/markdown": [".md", ".markdown", ".mdown"],
        "text/plain": [".md"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
